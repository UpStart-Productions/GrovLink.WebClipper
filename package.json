{
  "name": "grovlink-web-clipper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WXT_API_ENV=production wxt",
    "dev:local": "wxt",
    "dev:firefox": "WXT_API_ENV=production wxt -b firefox",
    "build": "WXT_API_ENV=production wxt build",
    "build:local": "wxt build",
    "build:store": "WXT_API_ENV=production WXT_STORE_BUILD=true wxt build",
    "build:release": "npm run build:store",
    "zip:store": "WXT_API_ENV=production WXT_STORE_BUILD=true wxt zip",
    "zip:release": "npm run zip:store",
    "zip": "npm run zip:store",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "wxt": "^0.19.13"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "aws-amplify": "^6.20.0",
    "chrono-node": "^2.9.1",
    "lucide-react": "^1.24.0",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
